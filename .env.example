# Copy to .env and fill in. .env is gitignored.

# Public hostname your reverse proxy serves pchat on (also used for STUN/TURN).
PCHAT_DOMAIN=chat.example.com

# LAN address of the machine running these containers (coturn binds to it).
HOST_IP=192.168.1.10

# Port the app is published on for your reverse proxy.
PCHAT_PORT=8085

# Shared secret between the app and coturn. Generate with:
#   head -c 32 /dev/urandom | base64 | tr -d '/+='
TURN_SECRET=change-me
